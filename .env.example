# InterviewOS environment variables
# Copy this file to .env.local and fill in your Groq key.
# The key is only read inside server-side Route Handlers (src/lib/groq.ts) and is never sent to the browser.

GROQ_API_KEY=

# Optional: override the Groq model used for generation/evaluation.
# GROQ_MODEL=llama-3.3-70b-versatile
