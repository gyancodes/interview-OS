# InterviewOS environment variables
# Copy this file to .env.local and fill in the values below.

# ---------------------------------------------------------------------------
# Groq (AI generation)
# ---------------------------------------------------------------------------
# Only read inside server-side route handlers (src/lib/groq.ts) and never sent
# to the browser.
GROQ_API_KEY=

# Optional: override the Groq model used for generation/evaluation.
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Appwrite (accounts, sessions, protected dashboard)
# ---------------------------------------------------------------------------
# 1. Create a project at https://cloud.appwrite.io
# 2. Add a Web platform with the hostname `localhost` (and your production domain)
# 3. Create an API key with the `users.write` and `sessions.write` scopes
#
# NEXT_PUBLIC_APPWRITE_ENDPOINT is the endpoint of your Appwrite instance.
# NEXT_PUBLIC_APPWRITE_PROJECT_ID is the project ID from the Appwrite console.
# APPWRITE_API_KEY is server-only and is never exposed to the browser.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

